# ─────────────────────────────────────────────────────────────
# Force the default *.netlify.app subdomain to the real domain
# so "netlify" never shows in the address bar (301 = permanent)
# ─────────────────────────────────────────────────────────────
https://setia-trafik.netlify.app/*  https://setiatrafik.com/:splat  301!

# ─────────────────────────────────────────────────────────────
# THE 7 LEGACY URLS — KEEP UNCHANGED
# 200! = serve the target page but the address bar STAYS /?page_id=NNN
# ─────────────────────────────────────────────────────────────
/   page_id=149   /services.html          200!
/   page_id=163   /products.html          200!
/   page_id=227   /who.html               200!
/   page_id=281   /coverage.html          200!
/   page_id=170   /certifications.html    200!
/   page_id=190   /news.html              200!

